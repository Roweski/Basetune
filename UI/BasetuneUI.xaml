<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basetune" MinHeight="800" MinWidth="1100" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" Background="#F0F4F8">
    <Window.Resources>

        <!-- ── Card border ───────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"    Value="White"/>
            <Setter Property="CornerRadius"  Value="10"/>
            <Setter Property="Padding"       Value="16"/>
            <Setter Property="Margin"        Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Form label ────────────────────────────────────────────────── -->
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <!-- ── Default controls ──────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="BorderBrush" Value="#DDE2EA"/>
            <!-- Disabled state: grey out the selected text so the user can
                 see the dropdown is inactive. WPF's default ComboBox template
                 does not visibly grey the selection content unless Foreground
                 is explicitly overridden here. -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderBrush"              Value="#DDE2EA"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Primary button ────────────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#1A6EF5"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Height"       Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1662D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9AA3B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button ──────────────────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#444"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="BorderBrush"     Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1662D9"/>
                                <Setter Property="Foreground"  Value="#1662D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Disabled state lives at Style level (not template level) so the
                 Foreground setter targets the Button itself. Path icons bind
                 their Fill via {RelativeSource AncestorType=Button} and only
                 see Foreground changes made directly on the Button. -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground"  Value="#AAA"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Setter Property="Cursor"      Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Icon-only secondary button (Download / Config / Options) ──
             Identical to SecBtn but with a black default foreground so the
             glyphs read as solid black. Disabled state stays grey via the
             existing IsEnabled trigger. -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource SecBtn}">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ── Modern scrollbar ───────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels"   Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width"    Value="8"/>
                    <Setter Property="MinWidth" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Width="8" Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineUpCommand"
                                                          Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineDownCommand"
                                                          Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="4" Margin="2,3"
                                                                Background="#C0C8D8"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Height="8" Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineLeftCommand"
                                                          Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineRightCommand"
                                                          Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border CornerRadius="4" Margin="3,2"
                                                                Background="#C0C8D8"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer inherits modern scrollbar automatically -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ── Status bar — pinned to bottom ───────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#F0F4F8" Padding="20,0,20,16">
            <StackPanel>
                <Border Background="White" CornerRadius="10" Margin="0" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                    </Border.Effect>
                    <!-- DockPanel: icon strip docked Right (takes natural width),
                         TextBox fills the remainder. The TextBox can no longer
                         render text behind the icons because the icons sit in
                         their own column — long lines visually truncate at the
                         icon strip's left edge (still horizontally scrollable
                         via keyboard, scrollbar hidden).
                         Icon strip right margin 10 aligns the buttons' right
                         edge with the policy textbox right edge:
                           policy textbox: main margin 20 + 0 (list card padding)
                                         + 10 (textbox Margin.Right) = 30px from window right
                           icon strip:    main padding 20 + this margin 10
                                         = 30px from window right -->
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="6,0,10,10">
                            <Button x:Name="btnOpenDownload" Style="{StaticResource IconBtn}"
                                    Height="29" Width="29" Padding="0" Margin="0,2,4,0"
                                    ToolTip="Download Definitions">
                                <!-- Top margin of 2px pushes the whole button down so the glyph
                                     visually aligns with the cog and sliders next to it. The
                                     download arrow's heavy head + thin underline make its optical
                                     center sit above its geometric center, so it reads as high
                                     when buttons are aligned by their geometric bottom edges. -->
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="btnOpenConfig" Style="{StaticResource IconBtn}"
                                    Height="29" Width="29" Padding="0" Margin="0,0,4,0"
                                    ToolTip="Tenant Configuration">
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="btnOpenOptions" Style="{StaticResource IconBtn}"
                                    Height="29" Width="29" Padding="0"
                                    ToolTip="Options">
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="txtLog" Height="100" VerticalContentAlignment="Top"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="#2A2A2A" Background="Transparent"
                                 BorderThickness="0" Padding="16,12,4,12"
                                 ScrollViewer.CanContentScroll="True"
                                 Text="Load source and target policies to get started."/>
                    </DockPanel>
                </Border>
                <ProgressBar x:Name="progressBar" Height="3" IsIndeterminate="False"
                             Value="0" Background="Transparent" Foreground="#1A6EF5"
                             BorderThickness="0" Visibility="Hidden" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Main content — fills space between header and status bar ── -->
        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Source + Target config row ────────────────────────────
                 Two separate cards (one per side) mirror the policy list
                 grid below (`*, 12, *`), so the inner controls line up
                 with the policy textboxes:
                   - dropdown left edge → source/target textbox left edge
                   - export button right edge → source/target textbox right edge
                 Each card uses Padding=10 so its inner content matches the
                 policy textbox Margin="10,0,10,6" inside the policy list
                 cards (which have Padding=0). -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Source tenant card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/> <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="29"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SOURCE TENANT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#999" Margin="0,0,0,10"/>
                            <ComboBox x:Name="cmbSourceTenant" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Grid>
                                <TextBlock x:Name="txtSourceFilterHint" Text="Policy name filter..."
                                           Foreground="#BBBBBB" FontSize="11" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="txtSourceFilter">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Background="Transparent">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,24,0"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button x:Name="btnClearSourceFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#BBBBBB" FontSize="10" Cursor="Hand"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="btnSourceLoad" Grid.Column="4" Style="{StaticResource PrimaryBtn}" Height="29"
                                Margin="0,0,0,0" Padding="8,0,12,0" VerticalAlignment="Bottom">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Load" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="btnSourceExport" Grid.Column="6" Style="{StaticResource IconBtn}"
                                Margin="0,0,0,0" Height="29" VerticalAlignment="Bottom" Width="29" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Target tenant card -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/> <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="29"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TARGET TENANT" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#999" Margin="0,0,0,10"/>
                            <ComboBox x:Name="cmbTargetTenant" Padding="10,0,0,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Grid>
                                <TextBlock x:Name="txtTargetFilterHint" Text="Policy name filter..."
                                           Foreground="#BBBBBB" FontSize="11" Margin="9,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="txtTargetFilter">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Background="Transparent">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,24,0"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button x:Name="btnClearTargetFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,2,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#BBBBBB" FontSize="10" Cursor="Hand"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="btnTargetLoad" Grid.Column="4" Style="{StaticResource PrimaryBtn}" Height="29"
                                Margin="0,0,0,0" Padding="8,0,12,0" VerticalAlignment="Bottom">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Load" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="btnTargetExport" Grid.Column="6" Style="{StaticResource IconBtn}"
                                Margin="0,0,0,0" Height="29" VerticalAlignment="Bottom" Width="29" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Policy lists ─────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Source list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                            <TextBlock Text="SOURCE POLICIES" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#999" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="lblSourceCount" FontSize="11" Foreground="#1A6EF5"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="btnSourceAll"  Style="{StaticResource SecBtn}"
                                        Content="All"  Height="22" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                                <Button x:Name="btnSourceNone" Style="{StaticResource SecBtn}"
                                        Content="None" Height="22" Padding="8,0" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
                            <TextBlock x:Name="txtSourceSearchHint" Text="Filter policies..."
                                       Foreground="#BBBBBB" FontSize="11" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="txtSourceSearch" FontSize="11" BorderBrush="#DDE2EA"
                                     Padding="6,3,28,3" VerticalContentAlignment="Center" Background="Transparent"/>
                            <Button x:Name="btnClearSourceSearch" Content="✕"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="24" Height="24" Margin="0,0,2,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#BBBBBB" FontSize="10" Cursor="Hand"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ListBox x:Name="lstSource" BorderThickness="0" Background="Transparent"
                                 Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                         the first "_" in its text as an access key and
                                         hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Padding="4,3" FontSize="12" VerticalContentAlignment="Center">
                                        <TextBlock Text="{Binding Name}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"                    Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background"                Value="Transparent"/>
                                    <Setter Property="BorderThickness"            Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Target list -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                            <TextBlock Text="TARGET POLICIES" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#999" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="lblTargetCount" FontSize="11" Foreground="#1A6EF5"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="btnTargetAll"  Style="{StaticResource SecBtn}"
                                        Content="All"  Height="22" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                                <Button x:Name="btnTargetNone" Style="{StaticResource SecBtn}"
                                        Content="None" Height="22" Padding="8,0" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
                            <TextBlock x:Name="txtTargetSearchHint" Text="Filter policies..."
                                       Foreground="#BBBBBB" FontSize="11" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="txtTargetSearch" FontSize="11" BorderBrush="#DDE2EA"
                                     Padding="6,3,28,3" VerticalContentAlignment="Center" Background="Transparent"/>
                            <Button x:Name="btnClearTargetSearch" Content="✕"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="24" Height="24" Margin="0,0,2,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#BBBBBB" FontSize="10" Cursor="Hand"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ListBox x:Name="lstTarget" BorderThickness="0" Background="Transparent"
                                 Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                         the first "_" in its text as an access key and
                                         hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Padding="4,3" FontSize="12" VerticalContentAlignment="Center">
                                        <TextBlock Text="{Binding Name}"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"                    Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background"                Value="Transparent"/>
                                    <Setter Property="BorderThickness"            Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── Action buttons ───────────────────────────────────────── -->
            <!-- Col0(*) = left card width  → Compare
                 Col1(12) = gap between the two cards
                 Col2(*) = right card width → Run Report
                 (Download / Config / Options icon buttons now live next to the status log) -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCompare" Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Compare Policies" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="btnOpenReport" Grid.Column="2" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,2,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Run Report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
