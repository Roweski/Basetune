<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basetune" MinHeight="400" MinWidth="800" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- Own title bar + frame (WindowChrome) instead of the Windows frame.
         The Windows frame has an invisible ~7px resize border around the
         window; next to a monitor with another scaling (e.g. a Dell Display
         Manager zone beside the laptop) that border lands on the other
         monitor and Windows sized the window with the wrong scaling (1.75x).
         With GlassFrameThickness 0 there is no invisible border: resizing
         uses a 5px border inside the window. Drag, double-click to maximise,
         Aero Snap and Win+arrow keep working (caption = top 32px).
         WindowStyle SingleBorderWindow, not None: WindowChrome still hides
         the Windows title bar, and Windows animates maximise / minimise /
         restore only for a window with a caption style. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <!-- Styles (Card, PrimaryBtn, SecBtn, IconBtn, ConsoleIconBtn, InlineBtn,
         SectionLabel, HintText and the TextBox / ComboBox / CheckBox /
         ListBoxItem / ScrollBar look) come from BasetuneTheme.xaml,
         loaded into the application resources by Load-Xaml. Colours are
         theme brushes (DynamicResource), so light/dark switches live. -->

    <!-- rootBorder: thin window outline. When maximised, code sets its Margin
         to the part of the window that Windows places off-screen, so the
         content stays fully visible. -->
    <Border x:Name="rootBorder" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
    <DockPanel>

        <!-- ── Title bar (WindowChrome caption) ────────────────────────── -->
        <Grid x:Name="titleBar" DockPanel.Dock="Top" Height="32" Background="{DynamicResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgTitleIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,8,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnCaptionMin"   Style="{StaticResource CaptionBtn}"      Content="&#xE921;" ToolTip="Minimize"/>
                <Button x:Name="btnCaptionMax"   Style="{StaticResource CaptionBtn}"      Content="&#xE922;" ToolTip="Maximize"/>
                <Button x:Name="btnCaptionClose" Style="{StaticResource CaptionCloseBtn}" Content="&#xE8BB;" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ── Status bar — pinned to bottom ───────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBrush}" Padding="20,0,20,16">
            <StackPanel>
                <!-- Log (console) card: light grey in light mode, dark terminal in dark mode. -->
                <Border Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Margin="0">
                    <!-- No DropShadowEffect (same as the Card style): an Effect
                         turns ClearType off for the log text. -->
                    <!-- The icon buttons (Download / Tenant Configuration / Options)
                         now sit next to Run Report (test); the log uses the full width. -->
                    <Grid>
                    <DockPanel LastChildFill="True">
                        <!-- RichTextBox (not TextBox) so single lines can be coloured
                             (ERROR = red). One Paragraph per log line, added by
                             Add-UILogLines in BasetuneLogView.psm1. PageWidth is wide so
                             long lines do not wrap (same as the old NoWrap TextBox).
                             IsDocumentEnabled: paths in the log are clickable links. -->
                        <RichTextBox x:Name="txtLog" IsTabStop="False" Height="100"
                                 IsReadOnly="True" IsDocumentEnabled="True"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{DynamicResource ConsoleFgBrush}" Background="Transparent"
                                 BorderThickness="0" Padding="16,10,40,10">
                            <!-- Fixed line height 16 + content height 80 (100 - 2x10 padding)
                                 = exactly 5 whole lines visible, no half line at the top.
                                 Collapsed (btnToggleLog): Height 36 = one line (16 + 2x10).
                                 Right padding 40 keeps text clear of the collapse button.
                                 Mouse-wheel LineUp/LineDown also scrolls 16px = one line. -->
                            <FlowDocument PageWidth="10000" PagePadding="0"
                                          FontFamily="Consolas" FontSize="12"
                                          LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                          Foreground="{DynamicResource ConsoleFgBrush}">
                                <!-- Empty at start: the first line is "Loading setting
                                     definitions and categories..." (Start-DefinitionPreload)
                                     or the warning that they are missing. -->
                            </FlowDocument>
                        </RichTextBox>
                    </DockPanel>
                    <!-- Collapse / expand the log (top right). Collapsed the log
                         shows only its last line. Always expanded at start. -->
                    <Button x:Name="btnToggleLog" TabIndex="20" Style="{StaticResource InlineBtn}"
                            Width="24" Height="24" Margin="0,6,10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTip="Collapse log">
                        <!-- Same chevron as the dropdown arrow of the tenant lists
                             (ComboToggleTemplate): 8x4, stroke 1.5, round caps.
                             Turns 180 degrees on collapse/expand (animated in
                             Basetune.ps1, 0.4 s). -->
                        <Path x:Name="pathToggleLog" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M0,0 L4,4 L8,0" RenderTransformOrigin="0.5,0.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="rotToggleLog" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <!-- Busy bar ON the card's bottom border line, between the
                         rounded corners (CornerRadius 12). Bottom margin -1 moves
                         it over the 1px border; nothing moves when it appears. -->
                    <ProgressBar x:Name="progressBar" Style="{StaticResource BusyBar}"
                                 IsIndeterminate="False" Value="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Bottom" Margin="14,0,14,-1"
                                 Visibility="Hidden"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Main content — fills space between header and status bar ── -->
        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Source + Target config row ────────────────────────────
                 Two separate cards (one per side) mirror the policy list
                 grid below (`*, 12, *`), so the inner controls line up
                 with the policy textboxes:
                   - dropdown left edge → source/target textbox left edge
                   - export button right edge → source/target textbox right edge
                 Each card uses Padding=10 so its inner content matches the
                 policy textbox Margin="10,0,10,6" inside the policy list
                 cards (which have Padding=0). -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Source tenant card -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="10">
                    <DockPanel>
                    <!-- Card title, left, lined up with the text in the tenant dropdown
                         (ComboBox padding 10 + border 1). -->
                    <TextBlock DockPanel.Dock="Top" Text="SOURCE TENANT" Style="{StaticResource SectionLabel}"
                               HorizontalAlignment="Left" Margin="11,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/> <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <ComboBox x:Name="cmbSourceTenant" TabIndex="1" Padding="10,0,30,0" VerticalContentAlignment="Center"
                                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                                <!-- Placeholder when Config.json has no tenants (Sync-MainTenantDropdowns) -->
                                <TextBlock x:Name="txtSourceTenantHint" Text="No tenants configured" Visibility="Collapsed"
                                           Style="{StaticResource HintText}" Margin="11,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <!-- Input background lives on this Border: the TextBox itself is
                                 transparent so the hint text behind it stays visible. -->
                            <Grid>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, ElementName=txtSourceFilter}" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid>
                                <TextBlock x:Name="txtSourceFilterHint" Text="Filter by name" Margin="9,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <!-- Same colour as the tenant dropdown text. -->
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=txtSourceFilter}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="txtSourceFilter" TabIndex="2"
                                         ToolTip="Filter policies by name before loading">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Background="Transparent" CornerRadius="8">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,24,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button x:Name="btnClearSourceFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,4,0"
                                        Style="{StaticResource InlineBtn}" FontSize="10"
                                        Visibility="Collapsed"/>
                            </Grid>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="btnSourceLoad" TabIndex="3" Grid.Column="4" Style="{StaticResource PrimaryBtn}" Height="32"
                                Margin="0,0,0,0" Padding="8,0,12,0" VerticalAlignment="Bottom">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Load" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="btnSourceExport" TabIndex="4" Grid.Column="6" Style="{StaticResource IconBtn}"
                                Margin="0,0,0,0" Height="32" VerticalAlignment="Bottom" Width="32" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                    </DockPanel>
                </Border>

                <!-- Target tenant card -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="10">
                    <DockPanel>
                    <!-- Card title, left, lined up with the text in the tenant dropdown
                         (ComboBox padding 10 + border 1). -->
                    <TextBlock DockPanel.Dock="Top" Text="TARGET TENANT" Style="{StaticResource SectionLabel}"
                               HorizontalAlignment="Left" Margin="11,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>  <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/> <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <ComboBox x:Name="cmbTargetTenant" TabIndex="5" Padding="10,0,30,0" VerticalContentAlignment="Center"
                                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                                <!-- Placeholder when Config.json has no tenants (Sync-MainTenantDropdowns) -->
                                <TextBlock x:Name="txtTargetTenantHint" Text="No tenants configured" Visibility="Collapsed"
                                           Style="{StaticResource HintText}" Margin="11,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <!-- Input background lives on this Border: the TextBox itself is
                                 transparent so the hint text behind it stays visible. -->
                            <Grid>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, ElementName=txtTargetFilter}" Value="False">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid>
                                <TextBlock x:Name="txtTargetFilterHint" Text="Filter by name" Margin="9,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <!-- Same colour as the tenant dropdown text. -->
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=txtTargetFilter}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="txtTargetFilter" TabIndex="6"
                                         ToolTip="Filter policies by name before loading">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border x:Name="bd" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Background="Transparent" CornerRadius="8">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,24,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button x:Name="btnClearTargetFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,4,0"
                                        Style="{StaticResource InlineBtn}" FontSize="10"
                                        Visibility="Collapsed"/>
                            </Grid>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="btnTargetLoad" TabIndex="7" Grid.Column="4" Style="{StaticResource PrimaryBtn}" Height="32"
                                Margin="0,0,0,0" Padding="8,0,12,0" VerticalAlignment="Bottom">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Load" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="btnTargetExport" TabIndex="8" Grid.Column="6" Style="{StaticResource IconBtn}"
                                Margin="0,0,0,0" Height="32" VerticalAlignment="Bottom" Width="32" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                            <Viewbox Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── Policy lists ─────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Source list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <!-- "No policies match 'x'" is centred over the whole card (not just the
                         list), so it sits at the same height whether the selection row shows or not. -->
                    <Grid>
                        <DockPanel>
                            <!-- Selection row: [select-all] "x / y selected"
                                 Sits at the top of the card (the list filter is the policy name filter in the
                                 tenant card). Checkbox lines up with the policy checkboxes (margin 15 = ListBox 8 + 1 +
                                 item padding 6). Checked = all visible selected, otherwise empty. -->
                            <StackPanel x:Name="pnlSourceSelect" DockPanel.Dock="Top" Visibility="Collapsed">
                                <!-- "x / y" selected / total (while searching: of the search results),
                                     centred on its own row above the column headers. Three parts, so
                                     the "/" stays put when the numbers change: the selected number
                                     right-aligned left of it, the total left-aligned right of it.
                                     While searching a filter mark shows left of the selected number
                                     (icoSourceFilter, Update-Counts) and moves with it. -->
                                <Grid Margin="15,10,12,0" ToolTip="Selected / total (while searching: of the search results)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- The same down triangle as a sorted column header (Update-ListSortHeaders). -->
                                        <TextBlock x:Name="icoSourceFilter" Text="&#x25BC;" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Search filter active: counts the search results"/>
                                        <TextBlock x:Name="lblSourceCountOn" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblSourceCountSlash" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="4,0"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblSourceCountOf" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Grid>
                                <!-- Column headers (click = sort, again = reverse): Policy left, Type and
                                     Platform right (Platform when the policies have platform info).
                                     Platform header is 88 wide (room for the sort arrow), rows 69;
                                     its left edge lines up with the row
                                     platform text (rows: margin right 0, above the scrollbar space). -->
                                <!-- Header row (fixed above the list). Margins: it lines up with the
                                     ListBox (8 left/right); 8 + 7 padding = 15 and 8 + 4 = 12 keep the
                                     checkbox and headers above the row checkboxes and text. -->
                                <Border Margin="8,4,8,0" Padding="7,1.5,4,2.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkSourceAll" TabIndex="9" Grid.Column="0" VerticalAlignment="Center" Padding="0"
                                              FocusVisualStyle="{x:Null}" ToolTip="Select or deselect all policies in the list"/>
                                    <Button x:Name="btnSourceSortName" Grid.Column="1" Style="{StaticResource ColumnHeaderBtn}"
                                            Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="POLICY"
                                            ToolTip="Sort by policy name"/>
                                    <!-- Rows: Type 100 wide, Platform 69 (just wide enough, so both sit close to
                                         the right edge). Type header = 100 + 12 (row margin) = 112, Platform header
                                         = 69 + 19 (scrollbar space) = 88, so both left edges line up with the row text
                                         (margin set in Update-ListSortHeaders). -->
                                    <Button x:Name="btnSourceSortType" Grid.Column="2" Style="{StaticResource ColumnHeaderBtn}"
                                            Width="112" Content="TYPE" ToolTip="Sort by policy type"/>
                                    <Button x:Name="btnSourceSortPlatform" Grid.Column="3" Style="{StaticResource ColumnHeaderBtn}"
                                            Width="88" Margin="0,0,0,0" Visibility="Collapsed" Content="PLATFORM"
                                            ToolTip="Sort by platform"/>
                                </Grid>
                                </Border>
                            </StackPanel>
                            <ListBox x:Name="lstSource" Padding="0" TabIndex="10" BorderThickness="0" Background="Transparent"
                                     Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Item"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.IsDeferredScrollingEnabled="False">
                                <!-- The theme's implicit ScrollViewer style (Auto) wins over the
                                     attached property above: force no horizontal scrollbar here.
                                     Long names are cut off with "..." and shown in full as tooltip. -->
                                <ListBox.Resources>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                        <!-- Always reserve the scrollbar width (the bar itself only shows when
                                             the list scrolls), so the Platform column lines up with its header. -->
                                        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                             the first "_" in its text as an access key and
                                             hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Padding="8,1" FontSize="13" VerticalContentAlignment="Center">
                                            <!-- Right: type, then platform (Windows, macOS, iOS, ...). -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- A cut-off policy name or type shows its tooltip at once (others wait the Windows default). -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="0"/>
                                                <!-- Type (always): Settings Catalog, Security Baseline, Endpoint Security, Enrollment. -->
                                                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="12"
                                                           Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeLabel}" ToolTipService.InitialShowDelay="0"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PlatformLabel}" FontSize="12"
                                                           Width="69" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedBrush}">
                                                    <!-- No platform info (empty): no width, the name uses the space. -->
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlatformLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PlatformLabel}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <!-- Card message; cut off with "..." in a small window, the full text
                             is the tooltip (none while empty). Only the text itself takes
                             the mouse, so the list underneath keeps working. -->
                        <TextBlock x:Name="lblSourceNoMatch" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </Trigger>
                                        <!-- "Configure a tenant to get started": clickable, opens Tenant Configuration -->
                                        <Trigger Property="Text" Value="Configure a tenant to get started">
                                            <Setter Property="ToolTip" Value="Open Tenant Configuration"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Target list -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                    <!-- "No policies match 'x'" is centred over the whole card (not just the
                         list), so it sits at the same height whether the selection row shows or not. -->
                    <Grid>
                        <DockPanel>
                            <!-- Selection row: [select-all] "x / y selected"
                                 Sits at the top of the card (the list filter is the policy name filter in the
                                 tenant card). Checkbox lines up with the policy checkboxes (margin 15 = ListBox 8 + 1 +
                                 item padding 6). Checked = all visible selected, otherwise empty. -->
                            <StackPanel x:Name="pnlTargetSelect" DockPanel.Dock="Top" Visibility="Collapsed">
                                <!-- "x / y" selected / total (while searching: of the search results),
                                     centred on its own row above the column headers. Three parts, so
                                     the "/" stays put when the numbers change: the selected number
                                     right-aligned left of it, the total left-aligned right of it.
                                     While searching a filter mark shows left of the selected number
                                     (icoTargetFilter, Update-Counts) and moves with it. -->
                                <Grid Margin="15,10,12,0" ToolTip="Selected / total (while searching: of the search results)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- The same down triangle as a sorted column header (Update-ListSortHeaders). -->
                                        <TextBlock x:Name="icoTargetFilter" Text="&#x25BC;" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Search filter active: counts the search results"/>
                                        <TextBlock x:Name="lblTargetCountOn" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblTargetCountSlash" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="4,0"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblTargetCountOf" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </Grid>
                                <!-- Column headers (click = sort, again = reverse): Policy left, Type and
                                     Platform right (Platform when the policies have platform info).
                                     Platform header is 88 wide (room for the sort arrow), rows 69;
                                     its left edge lines up with the row
                                     platform text (rows: margin right 0, above the scrollbar space). -->
                                <!-- Header row (fixed above the list). Margins: it lines up with the
                                     ListBox (8 left/right); 8 + 7 padding = 15 and 8 + 4 = 12 keep the
                                     checkbox and headers above the row checkboxes and text. -->
                                <Border Margin="8,4,8,0" Padding="7,1.5,4,2.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkTargetAll" TabIndex="11" Grid.Column="0" VerticalAlignment="Center" Padding="0"
                                              FocusVisualStyle="{x:Null}" ToolTip="Select or deselect all policies in the list"/>
                                    <Button x:Name="btnTargetSortName" Grid.Column="1" Style="{StaticResource ColumnHeaderBtn}"
                                            Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="POLICY"
                                            ToolTip="Sort by policy name"/>
                                    <!-- Rows: Type 100 wide, Platform 69 (just wide enough, so both sit close to
                                         the right edge). Type header = 100 + 12 (row margin) = 112, Platform header
                                         = 69 + 19 (scrollbar space) = 88, so both left edges line up with the row text
                                         (margin set in Update-ListSortHeaders). -->
                                    <Button x:Name="btnTargetSortType" Grid.Column="2" Style="{StaticResource ColumnHeaderBtn}"
                                            Width="112" Content="TYPE" ToolTip="Sort by policy type"/>
                                    <Button x:Name="btnTargetSortPlatform" Grid.Column="3" Style="{StaticResource ColumnHeaderBtn}"
                                            Width="88" Margin="0,0,0,0" Visibility="Collapsed" Content="PLATFORM"
                                            ToolTip="Sort by platform"/>
                                </Grid>
                                </Border>
                            </StackPanel>
                            <ListBox x:Name="lstTarget" Padding="0" TabIndex="12" BorderThickness="0" Background="Transparent"
                                     Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Item"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.IsDeferredScrollingEnabled="False">
                                <!-- The theme's implicit ScrollViewer style (Auto) wins over the
                                     attached property above: force no horizontal scrollbar here.
                                     Long names are cut off with "..." and shown in full as tooltip. -->
                                <ListBox.Resources>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                        <!-- Always reserve the scrollbar width (the bar itself only shows when
                                             the list scrolls), so the Platform column lines up with its header. -->
                                        <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                             the first "_" in its text as an access key and
                                             hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Padding="8,1" FontSize="13" VerticalContentAlignment="Center">
                                            <!-- Right: type, then platform (Windows, macOS, iOS, ...). -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- A cut-off policy name or type shows its tooltip at once (others wait the Windows default). -->
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="0"/>
                                                <!-- Type (always): Settings Catalog, Security Baseline, Endpoint Security, Enrollment. -->
                                                <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="12"
                                                           Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeLabel}" ToolTipService.InitialShowDelay="0"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PlatformLabel}" FontSize="12"
                                                           Width="69" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedBrush}">
                                                    <!-- No platform info (empty): no width, the name uses the space. -->
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlatformLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PlatformLabel}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <!-- Card message; cut off with "..." in a small window, the full text
                             is the tooltip (none while empty). Only the text itself takes
                             the mouse, so the list underneath keeps working. -->
                        <TextBlock x:Name="lblTargetNoMatch" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </Trigger>
                                        <!-- "Configure a tenant to get started": clickable, opens Tenant Configuration -->
                                        <Trigger Property="Text" Value="Configure a tenant to get started">
                                            <Setter Property="ToolTip" Value="Open Tenant Configuration"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Action buttons ───────────────────────────────────────── -->
            <!-- Col0(*) = left card width  → Compare
                 Col1(12) = gap between the two cards
                 Col2(*) = right card width → View Report (*) + View Details (*,
                 always equally wide) + the Download / Tenant Configuration /
                 Options icon buttons (Auto). View Report starts at the left
                 edge of the target card, like Compare at the source card. -->
            <Grid Grid.Row="2" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnCompare" TabIndex="13" Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Compare Policies" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Same gap as between Compare and View Report (12). -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnOpenReport" TabIndex="14" Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                            IsEnabled="False">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,2,6,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="View Report" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <!-- View Details: opens diff.csv of the same compare. Enabled
                         together with View Report (binding), so it follows every
                         place that switches the report on or off. -->
                    <Button x:Name="btnViewDetails" TabIndex="15" Grid.Column="2" Style="{StaticResource PrimaryBtn}"
                            IsEnabled="{Binding IsEnabled, ElementName=btnOpenReport}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,2,6,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M5,8V12H11V8H5M13,8V12H19V8H13M5,14V18H11V14H5M13,14V18H19V14H13Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="View Details" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <!-- Download / Tenant Configuration / Options (were in the log
                         card). Same height as the buttons next to them (34). -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button x:Name="btnOpenDownload" TabIndex="16" Style="{StaticResource IconBtn}"
                                Height="34" Width="34" Padding="0" Margin="0,0,12,0"
                                ToolTip="Download Definitions"
                                ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                            <!-- Size 16 in the 32px button: an even leftover (16px) centres the
                                 arrow horizontally (with 15 it was split 8/9). Margin top 2 moves
                                 it exactly 1px down, which looks centred. The code rebuilds this
                                 icon with the same values (New-DownloadButtonContent). -->
                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnOpenConfig" TabIndex="17" Style="{StaticResource IconBtn}"
                                Height="34" Width="34" Padding="0" Margin="0,0,12,0"
                                ToolTip="Tenant Configuration"
                                ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                            <Viewbox Width="15" Height="15" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="btnOpenOptions" TabIndex="18" Style="{StaticResource IconBtn}"
                                Height="34" Width="34" Padding="0"
                                ToolTip="Options"
                                ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                            <Viewbox Width="15" Height="15" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
    </Border>
</Window>
