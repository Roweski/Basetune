<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Basetune" MinHeight="400" MinWidth="800" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- TextRenderingMode Grayscale (not ClearType): fuller, calmer text on the dark surfaces, as in a browser. -->
    <!-- Own title bar + frame (WindowChrome) instead of the Windows frame.
         The Windows frame has an invisible ~7px resize border around the
         window; next to a monitor with another scaling (e.g. a Dell Display
         Manager zone beside the laptop) that border lands on the other
         monitor and Windows sized the window with the wrong scaling (1.75x).
         With GlassFrameThickness 0 there is no invisible border: resizing
         uses a 5px border inside the window. Drag, double-click to maximise,
         Aero Snap and Win+arrow keep working (caption = top 32px).
         WindowStyle SingleBorderWindow, not None: WindowChrome still hides
         the Windows title bar, and Windows animates maximise / minimise /
         restore only for a window with a caption style. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <!-- Styles (Card, the Strip* styles, InlineBtn, ColumnHeaderBtn,
         HintText and the TextBox / ComboBox / CheckBox /
         ListBoxItem / ScrollBar look) come from BasetuneTheme.xaml,
         loaded into the application resources by Load-Xaml. Colours are
         theme brushes (DynamicResource), so light/dark switches live. -->

    <!-- rootBorder: thin window outline. When maximised, code sets its Margin
         to the part of the window that Windows places off-screen, so the
         content stays fully visible. -->
    <Border x:Name="rootBorder" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
    <DockPanel>

        <!-- ── Title bar (WindowChrome caption) ────────────────────────── -->
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgTitleIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,8,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnCaptionMin"   Style="{StaticResource CaptionBtn}"      Content="&#xE921;" ToolTip="Minimize"/>
                <Button x:Name="btnCaptionMax"   Style="{StaticResource CaptionBtn}"      Content="&#xE922;" ToolTip="Maximize"/>
                <Button x:Name="btnCaptionClose" Style="{StaticResource CaptionCloseBtn}" Content="&#xE8BB;" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ── Main content — fills the window under the title bar ── -->
        <!-- Two cards side by side, source left and target right: the tenant
             strip on top (the strip style of the HTML report), a line
             (StripHSep), the policy list. Under them one actions card over the
             full width: the log and the button strip. The Grid in each card is
             clipped to the rounded card from code (Initialize-BasetuneWindow),
             so the square segments (a red Cancel) never show past the corners. -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Test (joined): no gap, the tenant strip and the policy list are one card. -->
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Source card -->
            <!-- Source tenant strip as a card of its own (gap 12 to the list card), as the actions card at the bottom -->
            <!-- Test (joined): the strip is the top of the source card (rounded top
                 corners, no bottom border), the list card under it the bottom
                 (its top border the line between them). ZIndex 1: the strip over the
                 list card, so the line of an action segment (1px under the strip)
                 lies on that border. -->
            <DockPanel Grid.Row="0" Grid.Column="0" Panel.ZIndex="1">
            <Border Style="{StaticResource Card}" Margin="0" Padding="0" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
                <Grid x:Name="stripSource">
                        <!-- Tenant strip: Baseline Configuration (layers icon) | tenant | name filter | Load | Export. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{DynamicResource StripLoadWidth}"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- In place of a SOURCE label: the layers icon (outline; the filled one
                                 in the buttons strip opens Baseline Configuration on the side used
                                 last), opens Baseline Configuration on the source tenant. -->
                            <Button x:Name="btnSourceConfig" TabIndex="0" Grid.Column="0" Style="{StaticResource StripActiveBtn}" BorderBrush="Transparent"
                                    Height="34" Padding="0" ToolTip="Baseline Configuration" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IconLayersOutline}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                            <Grid Grid.Column="2">
                                <ComboBox x:Name="cmbSourceTenant" TabIndex="1" Style="{StaticResource StripCombo}"
                                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                                <!-- Placeholder when Config.json has no baselines (Sync-MainTenantDropdowns) -->
                                <TextBlock x:Name="txtSourceTenantHint" Text="No baselines configured" Visibility="Collapsed"
                                           Style="{StaticResource HintText}" Margin="14,0,0,0"/>
                            </Grid>
                            <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                            <!-- Filter segment: the hint text sits behind the transparent
                                 TextBox; hover tints the segment, focus draws the blue
                                 line at the bottom (as the other segments). -->
                            <Grid Grid.Column="4">
                                <TextBlock x:Name="txtSourceFilterHint" Text="Filter by name" Margin="40,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=txtSourceFilter}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="txtSourceFilter" TabIndex="2" Height="34" Padding="38,0,0,0"
                                         ToolTip="Filter policies by name before loading">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <!-- With text (a filter in use): the hover tint, as on mouse-over
                                                             and while typing; no line under a text field. The tint on the Grid. -->
                                                        <Grid x:Name="bg" Background="{DynamicResource HoverBrush}">
                                                            <Border x:Name="bd" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0,2,28,0"
                                                                              VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="bg" Property="Background" Value="Transparent"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="Text" Value=""/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </MultiTrigger>
                                                            <!-- Typing in the empty field: the hover tint, no line. -->
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                                                    <Condition Property="Text" Value=""/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <!-- Funnel while the text is the load filter ("Filter by name"), magnifier
                                     once policies are loaded and it searches the list ("Search policies").
                                     Update-FilterIcon sets the Data. Over the TextBox (its template draws
                                     the hover tint), not hit-testable. -->
                                <Path x:Name="pathSourceFilterIcon" Style="{StaticResource FilterFieldIcon}"
                                      Data="{StaticResource GeoFunnel}" IsEnabled="{Binding IsEnabled, ElementName=txtSourceFilter}"/>
                                <Button x:Name="btnClearSourceFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,6,0"
                                        Style="{StaticResource InlineBtn}" FontSize="10"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <Rectangle Grid.Column="5" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnSourceLoad" TabIndex="3" Grid.Column="6" Style="{StaticResource StripAccentBtn}"
                                    Height="34" Padding="12.5,0" ToolTip="Load policies">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Play triangle before a load, the reload arrows once policies are loaded (Update-LoadIcon);
                                             the triangle is off centre in its box, see StripPlayIconMargin (Set-StripMode). -->
                                        <Viewbox x:Name="vbSourceLoadIcon" Width="20" Height="20" Stretch="Uniform" Margin="{DynamicResource StripPlayIconMargin}" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="pathSourceLoadIcon" Style="{StaticResource IconPlay}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Load" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource StripLabelVisibility}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Rectangle Grid.Column="7" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnSourceExport" TabIndex="4" Grid.Column="8" Style="{StaticResource StripIconBtn}"
                                    Height="34" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                </Grid>
            </Border>
            </DockPanel>
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0" CornerRadius="0,0,8,8">
                <Grid x:Name="cardSource">
                    <!-- Source policy list -->
                    <Grid>
                        <!-- "No policies match 'x'" is centred over the whole card (not just the
                             list), so it sits at the same height whether the selection row shows or not. -->
                        <Grid>
                            <DockPanel>
                                <!-- Selection row: [select-all] "x / y selected"
                                     Sits at the top of the card (the list filter is the policy name filter in the
                                     tenant card). Checkbox lines up with the policy checkboxes (margin 15 = ListBox 8 + 1 +
                                     item padding 6). Checked = all visible selected, otherwise empty. -->
                                <StackPanel x:Name="pnlSourceSelect" DockPanel.Dock="Top" Visibility="Collapsed">
                                    <!-- "x / y" selected / total (while searching: of the search results),
                                         centred on its own row above the column headers. Three parts, so
                                         the "/" stays put when the numbers change: the selected number
                                         right-aligned left of it, the total left-aligned right of it.
                                         While searching a filter mark shows left of the selected number
                                         (icoSourceFilter, Update-Counts) and moves with it. -->
                                    <Grid x:Name="gridSourceCount" Margin="15,10,12,0" ToolTip="Selected / total (while searching: of the search results)">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- A dot, a shape (a text glyph sits on the baseline, never in the middle). -->
                                            <Ellipse x:Name="icoSourceFilter" Width="7" Height="7" Fill="{DynamicResource MutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,1,6,0" Visibility="Collapsed"
                                                     ToolTip="Search filter active: counts the search results"/>
                                            <TextBlock x:Name="lblSourceCountOn" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="lblSourceCountSlash" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="4,0"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblSourceCountOf" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <!-- Column headers (click = sort, again = reverse): Policy left, Type and
                                         Platform right (Platform when the policies have platform info).
                                         Platform header is 88 wide (room for the sort arrow), rows 69;
                                         its left edge lines up with the row
                                         platform text (rows: margin right 0, above the scrollbar space). -->
                                    <!-- Header row (fixed above the list). Margins: it lines up with the
                                         ListBox (8 left/right); 8 + 7 padding = 15 and 8 + 4 = 12 keep the
                                         checkbox and headers above the row checkboxes and text. -->
                                    <Border Margin="8,4,8,0" Padding="7,1.5,4,2.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkSourceAll" TabIndex="9" Grid.Column="0" VerticalAlignment="Center" Padding="0"
                                                  FocusVisualStyle="{x:Null}" ToolTip="Select or deselect all policies in the list"/>
                                        <Button x:Name="btnSourceSortName" Grid.Column="1" Style="{StaticResource ColumnHeaderBtn}"
                                                Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="POLICY"
                                                ToolTip="Sort by policy name"/>
                                        <!-- Rows: Type 100 wide, Platform 69 (just wide enough, so both sit close to
                                             the right edge). Type header = 100 + 12 (row margin) = 112, Platform header
                                             = 69 + 19 (scrollbar space) = 88, so both left edges line up with the row text
                                             (margin set in Update-ListSortHeaders). -->
                                        <Button x:Name="btnSourceSortType" Grid.Column="2" Style="{StaticResource ColumnHeaderBtn}"
                                                Width="112" Content="TYPE" ToolTip="Sort by policy type"/>
                                        <Button x:Name="btnSourceSortPlatform" Grid.Column="3" Style="{StaticResource ColumnHeaderBtn}"
                                                Width="88" Margin="0,0,0,0" Visibility="Collapsed" Content="PLATFORM"
                                                ToolTip="Sort by platform"/>
                                    </Grid>
                                    </Border>
                                </StackPanel>
                                <ListBox x:Name="lstSource" Padding="0" TabIndex="10" BorderThickness="0" Background="Transparent"
                                         Margin="8,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Item"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.IsDeferredScrollingEnabled="False">
                                    <!-- The theme's implicit ScrollViewer style (Auto) wins over the
                                         attached property above: force no horizontal scrollbar here.
                                         Long names are cut off with "..." and shown in full as tooltip. -->
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                            <!-- Always reserve the scrollbar width (the bar itself only shows when
                                                 the list scrolls), so the Platform column lines up with its header. -->
                                            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                                 the first "_" in its text as an access key and
                                                 hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Padding="8,1" FontSize="14" VerticalContentAlignment="Center">
                                                <!-- Right: type, then platform (Windows, macOS, iOS, ...). -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- A cut-off policy name or type shows its tooltip at once (others wait the Windows default). -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="0"/>
                                                    <!-- Type (always): Settings Catalog, Security Baseline, Endpoint Security, Enrollment. -->
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="12"
                                                               Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeLabel}" ToolTipService.InitialShowDelay="0"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PlatformLabel}" FontSize="12"
                                                               Width="69" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedBrush}">
                                                        <!-- No platform info (empty): no width, the name uses the space. -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlatformLabel}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PlatformLabel}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- Card message, in the placeholder colour (HintBrush, as "Filter by name");
                                 cut off with "..." in a small window, the full text
                                 is the tooltip (none while empty). Only the text itself takes
                                 the mouse, so the list underneath keeps working. -->
                            <TextBlock x:Name="lblSourceNoMatch" FontSize="14" Foreground="{DynamicResource HintBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </Trigger>
                                            <!-- "Configure a baseline to get started": clickable, opens Baseline Configuration -->
                                            <Trigger Property="Text" Value="Configure a baseline to get started">
                                                <Setter Property="ToolTip" Value="Open Baseline Configuration"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Target card -->
            <!-- Target tenant strip as a card of its own (gap 12 to the list card), as the actions card at the bottom -->
            <!-- Test (joined): the strip is the top of the target card (rounded top
                 corners, no bottom border), the list card under it the bottom
                 (its top border the line between them). ZIndex 1: the strip over the
                 list card, so the line of an action segment (1px under the strip)
                 lies on that border. -->
            <DockPanel Grid.Row="0" Grid.Column="2" Panel.ZIndex="1">
            <Border Style="{StaticResource Card}" Margin="0" Padding="0" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0">
                <Grid x:Name="stripTarget">
                        <!-- Tenant strip: Baseline Configuration (layers icon) | tenant | name filter | Load | Export. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="{DynamicResource StripLoadWidth}"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <!-- In place of a TARGET label: the layers icon (outline), opens
                                 Baseline Configuration on the target tenant. -->
                            <Button x:Name="btnTargetConfig" TabIndex="5" Grid.Column="0" Style="{StaticResource StripActiveBtn}" BorderBrush="Transparent"
                                    Height="34" Padding="0" ToolTip="Baseline Configuration" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IconLayersOutline}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                            <Grid Grid.Column="2">
                                <ComboBox x:Name="cmbTargetTenant" TabIndex="5" Style="{StaticResource StripCombo}"
                                          ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"/>
                                <!-- Placeholder when Config.json has no baselines (Sync-MainTenantDropdowns) -->
                                <TextBlock x:Name="txtTargetTenantHint" Text="No baselines configured" Visibility="Collapsed"
                                           Style="{StaticResource HintText}" Margin="14,0,0,0"/>
                            </Grid>
                            <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                            <!-- Filter segment: the hint text sits behind the transparent
                                 TextBox; hover tints the segment, focus draws the blue
                                 line at the bottom (as the other segments). -->
                            <Grid Grid.Column="4">
                                <TextBlock x:Name="txtTargetFilterHint" Text="Filter by name" Margin="40,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, ElementName=txtTargetFilter}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="txtTargetFilter" TabIndex="6" Height="34" Padding="38,0,0,0"
                                         ToolTip="Filter policies by name before loading">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <!-- With text (a filter in use): the hover tint, as on mouse-over
                                                             and while typing; no line under a text field. The tint on the Grid. -->
                                                        <Grid x:Name="bg" Background="{DynamicResource HoverBrush}">
                                                            <Border x:Name="bd" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                                                <ScrollViewer x:Name="PART_ContentHost" Margin="0,2,28,0"
                                                                              VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="bg" Property="Background" Value="Transparent"/>
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="Text" Value=""/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </MultiTrigger>
                                                            <!-- Typing in the empty field: the hover tint, no line. -->
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                                                    <Condition Property="Text" Value=""/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <!-- Funnel / magnifier: see pathSourceFilterIcon. -->
                                <Path x:Name="pathTargetFilterIcon" Style="{StaticResource FilterFieldIcon}"
                                      Data="{StaticResource GeoFunnel}" IsEnabled="{Binding IsEnabled, ElementName=txtTargetFilter}"/>
                                <Button x:Name="btnClearTargetFilter" Content="✕"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="24" Height="24" Margin="0,0,6,0"
                                        Style="{StaticResource InlineBtn}" FontSize="10"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <Rectangle Grid.Column="5" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnTargetLoad" TabIndex="7" Grid.Column="6" Style="{StaticResource StripAccentBtn}"
                                    Height="34" Padding="12.5,0" ToolTip="Load policies">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Play triangle before a load, the reload arrows once policies are loaded (Update-LoadIcon);
                                             the triangle is off centre in its box, see StripPlayIconMargin (Set-StripMode). -->
                                        <Viewbox x:Name="vbTargetLoadIcon" Width="20" Height="20" Stretch="Uniform" Margin="{DynamicResource StripPlayIconMargin}" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="pathTargetLoadIcon" Style="{StaticResource IconPlay}"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Load" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource StripLabelVisibility}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Rectangle Grid.Column="7" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnTargetExport" TabIndex="8" Grid.Column="8" Style="{StaticResource StripIconBtn}"
                                    Height="34" Padding="0" IsEnabled="False" ToolTip="Export Policies" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M14,3V5H17.59L12.67,9.91L14.08,11.32L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                </Grid>
            </Border>
            </DockPanel>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0" CornerRadius="0,0,8,8">
                <Grid x:Name="cardTarget">
                    <!-- Target policy list -->
                    <Grid>
                        <!-- "No policies match 'x'" is centred over the whole card (not just the
                             list), so it sits at the same height whether the selection row shows or not. -->
                        <Grid>
                            <DockPanel>
                                <!-- Selection row: [select-all] "x / y selected"
                                     Sits at the top of the card (the list filter is the policy name filter in the
                                     tenant card). Checkbox lines up with the policy checkboxes (margin 15 = ListBox 8 + 1 +
                                     item padding 6). Checked = all visible selected, otherwise empty. -->
                                <StackPanel x:Name="pnlTargetSelect" DockPanel.Dock="Top" Visibility="Collapsed">
                                    <!-- "x / y" selected / total (while searching: of the search results),
                                         centred on its own row above the column headers. Three parts, so
                                         the "/" stays put when the numbers change: the selected number
                                         right-aligned left of it, the total left-aligned right of it.
                                         While searching a filter mark shows left of the selected number
                                         (icoTargetFilter, Update-Counts) and moves with it. -->
                                    <Grid x:Name="gridTargetCount" Margin="15,10,12,0" ToolTip="Selected / total (while searching: of the search results)">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- A dot, a shape (a text glyph sits on the baseline, never in the middle). -->
                                            <Ellipse x:Name="icoTargetFilter" Width="7" Height="7" Fill="{DynamicResource MutedBrush}"
                                                     VerticalAlignment="Center" Margin="0,1,6,0" Visibility="Collapsed"
                                                     ToolTip="Search filter active: counts the search results"/>
                                            <TextBlock x:Name="lblTargetCountOn" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="lblTargetCountSlash" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Margin="4,0"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblTargetCountOf" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <!-- Column headers (click = sort, again = reverse): Policy left, Type and
                                         Platform right (Platform when the policies have platform info).
                                         Platform header is 88 wide (room for the sort arrow), rows 69;
                                         its left edge lines up with the row
                                         platform text (rows: margin right 0, above the scrollbar space). -->
                                    <!-- Header row (fixed above the list). Margins: it lines up with the
                                         ListBox (8 left/right); 8 + 7 padding = 15 and 8 + 4 = 12 keep the
                                         checkbox and headers above the row checkboxes and text. -->
                                    <Border Margin="8,4,8,0" Padding="7,1.5,4,2.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="chkTargetAll" TabIndex="11" Grid.Column="0" VerticalAlignment="Center" Padding="0"
                                                  FocusVisualStyle="{x:Null}" ToolTip="Select or deselect all policies in the list"/>
                                        <Button x:Name="btnTargetSortName" Grid.Column="1" Style="{StaticResource ColumnHeaderBtn}"
                                                Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="POLICY"
                                                ToolTip="Sort by policy name"/>
                                        <!-- Rows: Type 100 wide, Platform 69 (just wide enough, so both sit close to
                                             the right edge). Type header = 100 + 12 (row margin) = 112, Platform header
                                             = 69 + 19 (scrollbar space) = 88, so both left edges line up with the row text
                                             (margin set in Update-ListSortHeaders). -->
                                        <Button x:Name="btnTargetSortType" Grid.Column="2" Style="{StaticResource ColumnHeaderBtn}"
                                                Width="112" Content="TYPE" ToolTip="Sort by policy type"/>
                                        <Button x:Name="btnTargetSortPlatform" Grid.Column="3" Style="{StaticResource ColumnHeaderBtn}"
                                                Width="88" Margin="0,0,0,0" Visibility="Collapsed" Content="PLATFORM"
                                                ToolTip="Sort by platform"/>
                                    </Grid>
                                    </Border>
                                </StackPanel>
                                <ListBox x:Name="lstTarget" Padding="0" TabIndex="12" BorderThickness="0" Background="Transparent"
                                         Margin="8,0,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Item"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.IsDeferredScrollingEnabled="False">
                                    <!-- The theme's implicit ScrollViewer style (Auto) wins over the
                                         attached property above: force no horizontal scrollbar here.
                                         Long names are cut off with "..." and shown in full as tooltip. -->
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                                            <!-- Always reserve the scrollbar width (the bar itself only shows when
                                                 the list scrolls), so the Platform column lines up with its header. -->
                                            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- TextBlock instead of Content="{Binding Name}": a CheckBox treats
                                                 the first "_" in its text as an access key and
                                                 hides it (GPO_MOORE_x was shown as GPOMOORE_x). -->
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Padding="8,1" FontSize="14" VerticalContentAlignment="Center">
                                                <!-- Right: type, then platform (Windows, macOS, iOS, ...). -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- A cut-off policy name or type shows its tooltip at once (others wait the Windows default). -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" ToolTipService.InitialShowDelay="0"/>
                                                    <!-- Type (always): Settings Catalog, Security Baseline, Endpoint Security, Enrollment. -->
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="12"
                                                               Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TypeLabel}" ToolTipService.InitialShowDelay="0"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PlatformLabel}" FontSize="12"
                                                               Width="69" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedBrush}">
                                                        <!-- No platform info (empty): no width, the name uses the space. -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlatformLabel}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PlatformLabel}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- Card message, in the placeholder colour (HintBrush, as "Filter by name");
                                 cut off with "..." in a small window, the full text
                                 is the tooltip (none while empty). Only the text itself takes
                                 the mouse, so the list underneath keeps working. -->
                            <TextBlock x:Name="lblTargetNoMatch" FontSize="14" Foreground="{DynamicResource HintBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </Trigger>
                                            <!-- "Configure a baseline to get started": clickable, opens Baseline Configuration -->
                                            <Trigger Property="Text" Value="Configure a baseline to get started">
                                                <Setter Property="ToolTip" Value="Open Baseline Configuration"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <!-- Actions, over the full width under the source / target cards.
                 Collapsed: the log line and the buttons are cards of their own, the
                 buttons under the source card, the log line under the target card
                 (Baseline Configuration | Compare | View Report | View Details from the
                 left, Download | Options at the right edge, the rest
                 in the strip colour), the gap of the source / target cards (12) between
                 them. The buttons stay at the same place in both states (they never
                 move under the mouse). Expanded: the log (5 lines, resizable) and the buttons are one card over
                 the full width, the log on top, the strip under it
                 (Set-LogCollapsed); the card grows upwards, so the policy lists get
                 shorter. The Grids are clipped to the rounded cards
                 (Initialize-BasetuneWindow). -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" Padding="0">
                <Grid x:Name="cardActions">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Log (console): light grey in light mode, dark terminal in dark mode. -->
                    <Border x:Name="bdLog" Grid.Row="0" Background="{DynamicResource ConsoleBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                    <!-- RichTextBox (not TextBox) so single lines can be coloured
                         (ERROR = red). One Paragraph per log line, added by
                         Add-UILogLines in BasetuneLogView.psm1. PageWidth is wide so
                         long lines do not wrap (same as the old NoWrap TextBox).
                         IsDocumentEnabled: paths in the log are clickable links. -->
                    <RichTextBox x:Name="txtLog" IsTabStop="False" Height="110"
                                 IsReadOnly="True" IsDocumentEnabled="True"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 FontFamily="Consolas" FontSize="13"
                                 Foreground="{DynamicResource ConsoleFgBrush}" Background="Transparent"
                                 BorderThickness="0" Padding="9,10,16,10">
                        <!-- Fixed line height 18; expanded the height is lines x 18 + 2x10
                             padding (110 = 5 lines, Set-LogLines), so only whole lines
                             show, no half line at the top.
                             Collapsed (btnToggleLog): Height 34 = one line (18 + 2x8).
                             Mouse-wheel LineUp/LineDown also scrolls 18px = one line. -->
                        <FlowDocument PageWidth="10000" PagePadding="0"
                                      FontFamily="Consolas" FontSize="13"
                                      LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                      Foreground="{DynamicResource ConsoleFgBrush}">
                            <!-- Empty at start: the first line is "Loading setting
                                 definitions and categories..." (Start-DefinitionPreload)
                                 or the warning that they are missing. -->
                        </FlowDocument>
                    </RichTextBox>
                    </Border>
                    <!-- Resize grip on the top edge of the expanded log: drag up / down to
                         show more or fewer lines (whole lines; 5 by default, at least 2, at
                         most as much as half of the policy list cards, Set-LogLines).
                         Over the log's top padding, so it covers no text; collapsed it is hidden
                         (Set-LogCollapsed). -->
                    <Thumb x:Name="thumbLogResize" Grid.Row="0" Height="7" VerticalAlignment="Top"
                           Cursor="SizeNS" Panel.ZIndex="1" Visibility="Collapsed" Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Rectangle x:Name="sepLog" Grid.Row="1" Style="{StaticResource StripHSep}" Visibility="Collapsed"/>
                    <!-- Buttons card under the source card | log line card (collapsed log) under the
                         target card (Set-ActionsJoined: one full-width strip when expanded). -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <ColumnDefinition Width="12"/> <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Collapsed, the log (txtLog) moves in here and shows its last
                             line (on the console colour); expanded it is empty, in the strip
                             colour (transparent, as the icon buttons), and the log is back in bdLog.
                        -->
                        <!-- Log line card: open Basetune.log (icon) | the last log line (console colour) |
                             the chevron that expands the log (btnToggleLog; expanded it
                             moves to the right end of the buttons strip, Set-ActionsJoined). The Grid
                             is clipped to the rounded card (Initialize-BasetuneWindow). -->
                        <Border x:Name="cardLogLine" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                            <Grid x:Name="stripLogLine">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>   <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <!-- Open Basetune.log (the whole log file, all details): an icon segment
                                     in place of a STATUS label (Initialize-BasetuneWindow); expanded it
                                     moves into the buttons strip, left of the chevron (Set-ActionsJoined). -->
                                <Border x:Name="hostLogCollapsed" Grid.Column="0">
                                    <Button x:Name="btnOpenLog" TabIndex="19" Style="{StaticResource StripIconBtn}"
                                            Height="34" Padding="0" ToolTip="View Log"
                                            ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                                        <Viewbox Width="20" Height="20" Stretch="Uniform"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Style="{StaticResource IconLog}"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Border>
                                <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                                <Border x:Name="bdLogLine" Grid.Column="2" Background="Transparent"/>
                                <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                                <Border x:Name="hostToggleCollapsed" Grid.Column="4">
                                    <!-- Expand / collapse the log (bdLog, above the strip; collapsed it
                                         shows its last line). Same chevron as the dropdown arrow: pointing
                                         up while collapsed (expands it upwards), turned
                                         180 degrees (down) while expanded (animated,
                                         Set-LogToggleRotation). -->
                                    <Button x:Name="btnToggleLog" TabIndex="20" Style="{StaticResource StripIconBtn}"
                                            Height="34" Padding="0" ToolTip="Collapse log"
                                            ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                                        <Path x:Name="pathToggleLog" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,1,1,0" Data="M0,0 L4,4 L8,0" RenderTransformOrigin="0.5,0.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="cardButtons" Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                        <!-- Buttons strip: Baseline Configuration | Compare | View Report | View Details,
                             the empty strip, then Download | Options at the right edge. The three
                             labelled action buttons one width (the widest content with the side padding of an
                             icon button, 12.5), or 40 icon only in a narrow window (Set-StripMode). -->
                        <Grid x:Name="stripActions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="40"/>   <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="40"/>
                                <!-- Expanded log: the log button (btnOpenLog) and the chevron (btnToggleLog) at the right end of the strip, the
                                     place it has in the log line card when collapsed (Set-ActionsJoined). -->
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Baseline Configuration first: an icon segment (no line) in the rounded corner,
                                 so Compare, whose line needs a straight edge, is never in the corner. The
                                 filled layers icon; the outline one beside each tenant dropdown opens it
                                 on that side's tenant. -->
                            <Button x:Name="btnOpenConfig" TabIndex="13" Grid.Column="0" Style="{StaticResource StripLayersBtn}"
                                    Height="34" Padding="0" ToolTip="Baseline Configuration"
                                    ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                                <Viewbox Width="20" Height="20" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IconLayersFilled}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                        <Button x:Name="btnCompare" TabIndex="14" Grid.Column="2" Style="{StaticResource StripActiveBtn}"
                                Height="34" Width="{DynamicResource StripActionWidth}" Padding="{DynamicResource StripActionPadding}" IsEnabled="False" ToolTip="Compare Policies">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Two opposite arrows (source and target compared); symmetric in its box,
                                         so the same margin as the other 20px strip icons. -->
                                    <Viewbox Width="20" Height="20" Stretch="Uniform" Margin="-1,1,0,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource IconSwap}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Compare" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource StripLabelVisibility}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                            <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnOpenReport" TabIndex="15" Grid.Column="4" Style="{StaticResource StripSecondaryBtn}"
                                    Height="34" Width="{DynamicResource StripActionWidth}" Padding="{DynamicResource StripActionPadding}" IsEnabled="False" ToolTip="View Report">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Stretch="Uniform" Margin="-1,1,0,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V13H17V17Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="View Report" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource StripLabelVisibility}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Rectangle Grid.Column="5" Style="{StaticResource StripSep}"/>
                            <Button x:Name="btnViewDetails" TabIndex="16" Grid.Column="6" Style="{StaticResource StripSecondaryBtn}"
                                    Height="34" Width="{DynamicResource StripActionWidth}" Padding="{DynamicResource StripActionPadding}" IsEnabled="{Binding IsEnabled, ElementName=btnOpenReport}" ToolTip="View Details">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="20" Height="20" Stretch="Uniform" Margin="-1,1,0,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M5,3C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H14V15H7Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="View Details" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{DynamicResource StripLabelVisibility}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Rectangle Grid.Column="7" Style="{StaticResource StripSep}"/>
                            <!-- The line before Download goes when the empty strip is under 2px (Set-StripMode),
                                 so the line after View Details and this one never show as a double line. -->
                            <Rectangle x:Name="sepStripGap" Grid.Column="9" Style="{StaticResource StripSep}"/>
                            <!-- Download icon 20 (all strip icons, as the layers icon): the View Report box with a list (dots and lines) cut out; the code
                                 rebuilds this icon with the same values (New-DownloadButtonContent). -->
                            <Button x:Name="btnOpenDownload" TabIndex="17" Grid.Column="10" Style="{StaticResource StripIconBtn}"
                                    Height="34" Padding="0" ToolTip="Download Definitions"
                                    ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                                <Viewbox Width="20" Height="20" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IconDownload}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle Grid.Column="11" Style="{StaticResource StripSep}"/>
                            <!-- Options: the tune sliders. -->
                            <Button x:Name="btnOpenOptions" TabIndex="18" Grid.Column="12" Style="{StaticResource StripIconBtn}"
                                    Height="34" Padding="0" ToolTip="Options"
                                    ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-4">
                                <Viewbox Width="20" Height="20" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource IconSliders}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Rectangle x:Name="sepLogExpanded" Grid.Column="13" Width="1" Style="{StaticResource StripSep}" Visibility="Collapsed"/>
                            <Border x:Name="hostLogExpanded" Grid.Column="14" Width="40" Visibility="Collapsed"/>
                            <Rectangle x:Name="sepToggleExpanded" Grid.Column="15" Width="1" Style="{StaticResource StripSep}" Visibility="Collapsed"/>
                            <Border x:Name="hostToggleExpanded" Grid.Column="16" Width="40" Visibility="Collapsed"/>
                        </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <!-- Busy bar ON the bottom border line of the log line card (the
                 right half; expanded the full width, Set-ActionsJoined), between the rounded
                 corners. Bottom margin 0: the card's bottom border is the last pixel row
                 of the row, so the 1px bar lies on it; nothing moves when it appears. -->
            <ProgressBar x:Name="progressBar" Grid.Row="4" Grid.Column="2" Panel.ZIndex="2"
                         Style="{StaticResource BusyBar}"
                         IsIndeterminate="False" Value="0"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Bottom" Margin="14,0,14,0"
                         Visibility="Hidden"/>
        </Grid>
    </DockPanel>
    </Border>
</Window>
