<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baseline Configuration"
        SizeToContent="Height" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <!-- TextRenderingMode Grayscale (not ClearType): fuller, calmer text on the dark surfaces, as in a browser. -->
    <!-- Styles and colours come from BasetuneTheme.xaml (application
         resources, loaded by Load-Xaml). Light/dark switches live. -->

    <!-- Own title bar + frame (WindowChrome), same as the main window: no
         invisible Windows border, so a Dell Display Manager zone next to a
         monitor with another scaling no longer makes the window bigger.
         The size stays fixed: a zone only sets the position (see
         Initialize-DialogChrome in BasetuneWpf.psm1). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="12" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
    <DockPanel>
        <!-- No title bar (Collapsed). Its close button stays: Initialize-DialogChrome
             is set up from it; the window moves by its 12px top margin (CaptionHeight). -->
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource BgBrush}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgDlgIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,8,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button x:Name="btnDlgClose" Grid.Column="2" Style="{StaticResource CaptionCloseBtn}"
                    Content="&#xE8BB;" ToolTip="Close"/>
        </Grid>

    <!-- Outer spacing: 12 on every side, the gap between the cards of the main window (also the top margin, by which the
         window moves: CaptionHeight). Card padding 10 at the top and sides, as
         the tenant cards in the main window (same label style and 6 under it),
         so the first field lines up with the tenant dropdown there. 15 at the
         bottom: the label line box adds about 5 above its capitals, so the
         visible gap from the card edge to the first label is about 15, and the
         last input gets the same gap to the bottom edge. 12 between the field
         rows. -->
    <!-- Maximum input lengths (typing / pasting): Display Name, Tenant ID,
         Client ID and Certificate Thumbprint 64, Client Secret 128. The JSON
         path has no limit. Values already in Config.json are not cut off. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Card -->
                <!-- No fixed height: the card is as high as the ClientSecret /
             Certificate form needs (the tallest one). For None (JSON) the
             Tenant ID and Client ID / Secret rows are Hidden, not Collapsed
             (Update-TenantAuthFields), so they keep their space and the
             window does not jump when the method changes. A fixed height
             (287) cut off the last row when labels render a bit higher. -->
                <!-- The card: the fields on top, a line, then the buttons as a strip at
                     the bottom of the card (as the button strip of the main window: the
                     rest in the strip colour, the action as an action segment (the hover tint and
                     the blue line when it can be used), Close an icon segment; stripButtons is clipped to the rounded card,
                     Initialize-DialogChrome). -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The tenant strip at the top of the card, as the tenant strip in the
                         main window: layers icon | dropdown | new (+) | remove, no label
                         (StripCombo, StripIconBtn segments, a line between them); a line under it.
                         Clipped to the rounded top corners (stripTenant, Initialize-DialogChrome). -->
                                <Grid x:Name="stripTenant" Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/> <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>  <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="40"/> <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- The layers icon (outline) of the tenant strips in the main window,
                                         a mark only (not a button). -->
                                    <Viewbox Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Style="{StaticResource IconLayersOutline}" Stroke="{DynamicResource SubTextBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                                    <Grid Grid.Column="2">
                                        <ComboBox x:Name="lstTenants" Style="{StaticResource StripCombo}"/>
                                        <!-- Placeholder while no tenant is selected; text set by
                                             Update-TenantListHint ("Add your first tenant below" / "Enter tenant details below" / "Select a tenant"). -->
                                        <TextBlock x:Name="lstTenantsHint" Style="{StaticResource HintText}" Margin="14,0,0,0"/>
                                    </Grid>
                                    <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                                    <!-- New tenant: empty form. Icon: MDI plus-circle-outline -->
                                    <Button x:Name="btnAddTenant" Grid.Column="4" Style="{StaticResource StripIconBtn}"
                                            Height="34" Padding="0" ToolTip="New tenant">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="0,1,0,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M13,7H11V11H7V13H11V17H13V13H17V11H13V7Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Rectangle Grid.Column="5" Style="{StaticResource StripSep}"/>
                                    <!-- Remove tenant: disabled while no saved tenant is selected -->
                                    <Button x:Name="btnRemoveTenant" Grid.Column="6" Style="{StaticResource StripIconBtn}"
                                            Height="34" Padding="0" IsEnabled="False" ToolTip="Remove tenant">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="0,1,0,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                    <Rectangle Grid.Row="1" Style="{StaticResource StripHSep}"/>
                <Border Grid.Row="2" Padding="10,10,10,15">
                    <StackPanel>

                        <!-- Tenant form -->
                        <!-- Hidden (not Collapsed) until shown: the space is reserved, so the window has its final height from the start. -->
                        <StackPanel x:Name="pnlTenantForm" Visibility="Hidden">

                            <!-- Display Name | Authentication Method -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FL}" Text="DISPLAY NAME"/>
                                        <TextBlock x:Name="reqDisplayName" Style="{StaticResource REQ}" Text="Required!"/>
                                    </StackPanel>
                                    <Grid>
                                        <TextBox x:Name="cfgTenantDisplayName" MaxLength="64" Padding="8,4,32,4"/>
                                        <!-- Clear (x), shown while the field has text; same as the filter fields in the main window -->
                                        <Button x:Name="btnClearDisplayName" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="24" Height="24" Margin="0,0,4,0" Style="{StaticResource InlineBtn}" FontSize="10"
                                                Visibility="Collapsed" ToolTip="Clear" Focusable="False"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FL}" Text="AUTHENTICATION METHOD"/>
                                    <!-- Content = the text shown, Tag = the authMethod value in Config.json
                                         (Get-TenantFormAuthMethod reads the Tag). -->
                                    <ComboBox x:Name="cfgTenantAuthMethod" Padding="10,0,0,0">
                                        <ComboBoxItem Content="Client Secret" Tag="ClientSecret" IsSelected="True"/>
                                        <ComboBoxItem Content="Certificate" Tag="Certificate"/>
                                        <ComboBoxItem Content="None (JSON)" Tag="None"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Credential area: fixed two-row grid so JSON and Secret/Cert views
                                 occupy identical height and the window never resizes -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- Tenant ID row -->
                                    <RowDefinition Height="Auto"/>  <!-- Client ID / Secret row -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Tenant ID (hidden for None) -->
                                <Grid x:Name="pnlTenantId" Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="TENANT ID"/>
                                            <TextBlock x:Name="reqTenantId" Style="{StaticResource REQ}" Text="Required!"/>
                                        </StackPanel>
                                        <Grid>
                                            <TextBox x:Name="cfgTenantTenantId" MaxLength="64" Padding="8,4,32,4"/>
                                            <!-- Clear (x), shown while the field has text; same as the filter fields in the main window -->
                                            <Button x:Name="btnClearTenantId" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="24" Height="24" Margin="0,0,4,0" Style="{StaticResource InlineBtn}" FontSize="10"
                                                    Visibility="Collapsed" ToolTip="Clear" Focusable="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 1: Client ID | Client Secret (hidden for None) -->
                                <Grid x:Name="pnlCredential" Grid.Row="1" Margin="0,0,0,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="pnlClientId">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="CLIENT ID"/>
                                            <TextBlock x:Name="reqClientId" Style="{StaticResource REQ}" Text="Required!"/>
                                        </StackPanel>
                                        <Grid>
                                            <TextBox x:Name="cfgTenantClientId" MaxLength="64" Padding="8,4,32,4"/>
                                            <!-- Clear (x), shown while the field has text; same as the filter fields in the main window -->
                                            <Button x:Name="btnClearClientId" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="24" Height="24" Margin="0,0,4,0" Style="{StaticResource InlineBtn}" FontSize="10"
                                                    Visibility="Collapsed" ToolTip="Clear" Focusable="False"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="lblTenantSecret" Style="{StaticResource FL}" Text="CLIENT SECRET"/>
                                            <TextBlock x:Name="reqClientSecret" Style="{StaticResource REQ}" Text="Required!"/>
                                        </StackPanel>
                                        <Grid>
                                            <!-- Default: PasswordBox (masked). Reveal-toggle flips visibility
                                                 with the TextBox below; the reveal button updates the value
                                                 on both controls so flipping is lossless. -->
                                            <PasswordBox x:Name="cfgTenantClientSecret" MaxLength="128" Padding="8,4,32,4"/>
                                            <TextBox     x:Name="cfgTenantClientSecretShown" MaxLength="128" Padding="8,4,32,4" Visibility="Collapsed"/>
                                            <Button x:Name="btnRevealSecret"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="28" Height="24" Margin="0,0,4,0"
                                                    Style="{StaticResource InlineBtn}"
                                                    ToolTip="Show / hide secret">
                                                <!-- Two inline SVG paths in a Canvas, sized 12x12 to match the
                                                     previous Segoe MDL2 glyph height. The PS code-behind toggles
                                                     Visibility between iconEyeOpen and iconEyeOff instead of
                                                     swapping a font-glyph string. Font-independent = identical
                                                     rendering on every Windows install, no Segoe MDL2 fallback. -->
                                                <Grid Width="12" Height="12">
                                                    <Path x:Name="iconEyeOpen"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.0"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M2 12 C 5 6, 9 5, 12 5 C 15 5, 19 6, 22 12 C 19 18, 15 19, 12 19 C 9 19, 5 18, 2 12 Z M 12 9 A 3 3 0 1 1 12 15 A 3 3 0 1 1 12 9 Z"/>
                                                    <Path x:Name="iconEyeOff"
                                                          Stretch="Uniform"
                                                          Visibility="Collapsed"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.0"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M3 3 L 21 21 M 6.5 6.5 C 4.5 8, 3 10, 2 12 C 5 18, 9 19, 12 19 C 13.5 19, 15 18.7, 16.3 18.3 M 9.5 9.5 A 3 3 0 0 0 14.5 14.5 M 17.5 17.5 C 19.5 16, 21 14, 22 12 C 19 6, 15 5, 12 5 C 10.5 5, 9 5.3, 7.7 5.7"/>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="lblTenantThumb" Style="{StaticResource FL}"
                                                       Text="CERTIFICATE THUMBPRINT" Visibility="Collapsed"/>
                                            <TextBlock x:Name="reqCertThumb" Style="{StaticResource REQ}" Text="Required!"/>
                                        </StackPanel>
                                        <!-- Grid follows the TextBox visibility (set by Update-TenantAuthFields), so the clear (x) hides with it -->
                                        <Grid Visibility="{Binding Visibility, ElementName=cfgTenantCertThumbprint}">
                                            <TextBox x:Name="cfgTenantCertThumbprint" MaxLength="64" Visibility="Collapsed" Padding="8,4,32,4"/>
                                            <Button x:Name="btnClearCertThumb" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="24" Height="24" Margin="0,0,4,0" Style="{StaticResource InlineBtn}" FontSize="10"
                                                    Visibility="Collapsed" ToolTip="Clear" Focusable="False"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- JSON Path — spans both rows, only visible for None (JSON) -->
                                <Grid x:Name="pnlTenantPath" Grid.Row="0" Grid.RowSpan="2"
                                      Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="POLICY FOLDER"/>
                                            <TextBlock x:Name="reqJsonPath" Style="{StaticResource REQ}" Text="Required!"/>
                                        </StackPanel>
                                        <Grid>
                                            <TextBox x:Name="cfgTenantPath" Padding="8,4,32,4"/>
                                            <Button x:Name="btnBrowseTenantPath"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="28" Height="24" Margin="0,0,4,0"
                                                    Style="{StaticResource InlineBtn}"
                                                    FontSize="12" Content="...">
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
                    <Rectangle Grid.Row="3" Style="{StaticResource StripHSep}"/>
                    <Grid x:Name="stripButtons" Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Connection test feedback (btnSaveConfig's Click, before / after the
                             New-GraphConnection probe); empty when idle. -->
                        <TextBlock x:Name="lblConnectionStatus" Grid.Column="0" VerticalAlignment="Center" Margin="14,0" FontSize="14" Text=""/>
                        <Rectangle Grid.Column="1" Style="{StaticResource StripSep}"/>
                        <Button x:Name="btnSaveConfig" Grid.Column="2" Style="{StaticResource StripAccentBtn}" Content="Save Config" Height="34" Padding="20,0" IsEnabled="False"/>
                        <Rectangle Grid.Column="3" Style="{StaticResource StripSep}"/>
                        <!-- Close: a neutral icon segment (40) with an X; the action left of it is the one with the blue line. -->
                        <Button x:Name="btnCloseConfig" Grid.Column="4" Style="{StaticResource StripIconBtn}" Width="40" Height="34" Padding="0" ToolTip="Close">
                            <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
                </Border>


    </Grid>
    </DockPanel>
    </Border>
</Window>