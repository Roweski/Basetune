<!--
    BasetuneTheme.xaml - shared styles for all Basetune windows.

    Loaded once by Initialize-BasetuneTheme (Modules\UI\BasetuneWpf.psm1) into
    Application.Current.Resources, so every window (main, Tenant
    Configuration, Options, Download) uses the same look.

    Colours are NOT defined here. Every brush is a DynamicResource whose
    value comes from the palette in BasetuneWpf.psm1 (light or dark). Switching
    the theme swaps that palette and all windows repaint at once.

    Brush keys used:
      BgBrush CardBrush CardBorderBrush TextBrush SubTextBrush MutedBrush
      HintBrush InputBgBrush InputBorderBrush AccentBrush
      AccentSoftBrush AccentSoftHoverBrush HoverBrush CheckTickBrush
      ActionBgBrush ActionFgBrush ActionHoverBgBrush ActionHoverFgBrush
      CancelActionBgBrush CancelActionFgBrush CancelActionHoverBgBrush CancelActionHoverFgBrush
      ActionLineBrush SecondaryActionBgBrush SecondaryActionFgBrush SecondaryActionHoverBgBrush SecondaryActionHoverFgBrush SecondaryActionLineBrush CancelActionLineBrush
      LayersBgBrush LayersFgBrush LayersHoverBgBrush LayersHoverFgBrush
      DisabledFgBrush IconFgBrush
      SecBtnFgBrush SectionLabelBrush ConsoleBgBrush ConsoleFgBrush
      ScrollThumbBrush PopupBgBrush
      PopupBorderBrush WarnBrush ErrorBrush
      CaptionHoverBrush
      CaptionPressedBrush
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Card ─────────────────────────────────────────────────────────── -->
    <!-- Corner radius 8 = the Windows 11 window corner (DWMWCP_ROUND, set in
         BasetuneWindow.psm1 / BasetuneWpf.psm1), as the buttons, inputs and
         dropdown list: one rounding for the whole window. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="16"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <!-- No DropShadowEffect: an Effect renders the whole card (and its
             text) as a bitmap, which turns ClearType off for every text in it. -->
    </Style>

    <!-- ── Labels ───────────────────────────────────────────────────────── -->
    <!-- Form label above an input (dialogs): 12, SemiBold, Basetune blue; TextBlock has no text
         transform, so the capitals are in the XAML text. Left margin 11 =
         border (1) + text inset of TextBox / PasswordBox / ComboBox, so the
         label starts exactly above the value; 6 between label and input. -->
    <Style x:Key="FL" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SectionLabelBrush}"/>
        <Setter Property="Margin"     Value="11,0,0,6"/>
    </Style>
    <!-- "Required!" marker next to a form label (hidden until validation).
         Left margin 6 = about one space after the semibold 12px label. -->
    <Style x:Key="REQ" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Margin"     Value="6,0,0,6"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <!-- ── Strip icons (24x24 canvas, in a Viewbox) ─────────────────────────
         The colour comes from the Button around them (Fill / Stroke bound to
         its Foreground), so hover, the disabled colour and the attention look
         reach the icon. Outline icons are strokes (round ends). -->
    <!-- Layers, filled: Baseline Configuration (buttons strip). The two bands are
         1.8 thick (square to their slope), the stroke of the outline version. -->
    <Style x:Key="IconLayersFilled" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Data" Value="M12,2.5L22,8L12,13.5L2,8Z M2,12.2L3.86,11.18L12,15.65L20.14,11.18L22,12.2L12,17.7Z M2,16.4L3.86,15.38L12,19.85L20.14,15.38L22,16.4L12,21.9Z"/>
    </Style>
    <!-- Layers, outline: Baseline Configuration on one side's tenant (the tenant
         strips) and the mark of the tenant dropdown in Baseline Configuration. -->
    <Style x:Key="IconLayersOutline" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Data" Value="M12,3L21,8L12,13L3,8Z M3,12L12,17L21,12 M3,16L12,21L21,16"/>
    </Style>
    <!-- Two opposite arrows: Compare. Both span x 4..20, so they line up. -->
    <Style x:Key="IconSwap" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Data" Value="M4,8H20 M16,4L20,8L16,12 M20,16H4 M8,12L4,16L8,20"/>
    </Style>
    <!-- Options: the MDI tune sliders (filled path), the weight of View Report / Export. -->
    <Style x:Key="IconSliders" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Data" Value="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"/>
    </Style>
    <!-- Download Definitions: the filled box of View Report (3..21, corners 2) with a
         list cut out (even-odd fill): three square dots (2 x 2) and three lines of 2,
         square as the lines of View Details and on its rows (y 7, 11, 15): dots
         5.5..7.5, lines 9.5..18.5, so the room left and right inside the box is
         the same (2.5).
         New-DownloadButtonContent builds the same icon from code. -->
    <Style x:Key="IconDownload" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Data" Value="M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3Z M5.5,7H7.5V9H5.5Z M9.5,7H18.5V9H9.5Z M5.5,11H7.5V13H5.5Z M9.5,11H18.5V13H9.5Z M5.5,15H7.5V17H5.5Z M9.5,15H18.5V17H9.5Z"/>
    </Style>
    <!-- Open Basetune.log: the outline of View Details (3..21, corners 2, walls 2)
         with only its short line (7..14, 7..9) at the top left, filled path. -->
    <Style x:Key="IconLog" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Data" Value="M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,5V19H19V5H5Z M7,7V9H14V7H7Z"/>
    </Style>
    <!-- Reload arrows (MDI refresh): Load once policies are loaded (Update-LoadIcon
         sets it as the Data of the play Path). -->
    <Geometry x:Key="GeoReload">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
    <!-- Play triangle: Load. -->
    <Style x:Key="IconPlay" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Data" Value="M8,5.14V19.14L19,12.14L8,5.14Z"/>
    </Style>
    <!-- Name filter field icons (Update-FilterIcon switches the Data), one family (a wide
         load filter, magnifier = search in the loaded list. -->
    <Geometry x:Key="GeoFunnel">M22,3H2L10,12.46V19L14,21V12.46Z</Geometry>
    <Geometry x:Key="GeoSearch">M4,10.5A6.5,6.5 0 1,1 17,10.5A6.5,6.5 0 1,1 4,10.5Z M15.2,15.2L20,20</Geometry>
    <!-- The icon left in the name filter field, over the TextBox (not
         hit-testable), 13.5, a little over the Export and reload icons; the hint
         text and the typed text start right of it.
         IsEnabled is bound to the field's: the disabled colour with it. -->
    <Style x:Key="FilterFieldIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource SubTextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Width" Value="13.5"/>
        <Setter Property="Height" Value="13.5"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="14,1,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Stroke" Value="{DynamicResource DisabledFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Placeholder text that sits behind a transparent TextBox (or in an
         empty dropdown): 13, a little smaller than the 14 of a value. -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground"        Value="{DynamicResource HintBrush}"/>
        <Setter Property="FontStyle"         Value="Italic"/>
        <Setter Property="FontSize"          Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- Keyboard focus (Tab) looks like hover. WPF shows a FocusVisualStyle only
         for keyboard navigation, never after a mouse click, so nothing sticks.
         AccentFocusVisual: accent outline, same as hovering a neutral button. -->
    <Style x:Key="AccentFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption buttons of the main window's own title bar (WindowChrome):
         minimise / maximise / close, Windows 11 size (46x32) and glyphs
         (Segoe Fluent Icons, Segoe MDL2 Assets on Windows 10). -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Focusable"       Value="False"/>
        <Setter Property="IsTabStop"       Value="False"/>
        <Setter Property="FontFamily"      Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B0291B"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small transparent button inside an input: clear (x), browse (...),
         show/hide secret. Grey, blue on hover. -->
    <Style x:Key="InlineBtn" TargetType="Button">
        <!-- Keyboard focus (Tab) looks like hover (see AccentFocusVisual). -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TextBox ──────────────────────────────────────────────────────── -->
    <!-- Dialog fields look like the segments of the main window: a flat
         fill without a visible border (BorderBrush = the fill), the hover
         tint on mouse-over and while typing (keyboard focus), no blue
         border. The 1px border stays, so a red BorderBrush set from code
         (invalid value) still shows. -->
    <Style TargetType="TextBox">
        <Setter Property="Height"                   Value="32"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background"               Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding"                  Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid>
                            <!-- Mouse-over: the hover tint over the input colour. -->
                            <Border x:Name="tint" CornerRadius="7" Background="Transparent"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── PasswordBox (same look as TextBox) ───────────────────────────── -->
    <Style TargetType="PasswordBox">
        <Setter Property="Height"                   Value="32"/>
        <Setter Property="FontSize"                 Value="14"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background"               Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource InputBgBrush}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding"                  Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid>
                            <!-- Mouse-over: the hover tint over the input colour. -->
                            <Border x:Name="tint" CornerRadius="7" Background="Transparent"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox ─────────────────────────────────────────────────────── -->
    <!-- The whole closed box is one toggle button, so a click anywhere
         opens the list. The list opens as a card below the box. -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="bd" Background="{DynamicResource InputBgBrush}"
                BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- A flat fill as the TextBox. Mouse-over and open: the
                     hover tint over the fill (as a strip segment), open also a
                     blue arrow; no blue border. -->
                <Border x:Name="tint" CornerRadius="7" Background="Transparent"/>
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tint" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Keyboard focus on a rounded dialog field (ComboBox): the hover tint
         over it, rounded as the field. WPF shows a focus visual for the keyboard
         only, so a mouse click leaves no other colour (only the hover tint). -->
    <Style x:Key="FieldFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <!-- Keyboard focus (Tab) shows the hover tint (FieldFocusVisual), as
             StripCombo, not an outline. -->
        <Setter Property="FocusVisualStyle"           Value="{StaticResource FieldFocusVisual}"/>
        <Setter Property="Height"                     Value="32"/>
        <Setter Property="FontSize"                   Value="14"/>
        <Setter Property="Foreground"                 Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding"                    Value="10,0,28,0"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Template="{StaticResource ComboToggleTemplate}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="content" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <!-- A long selected name is cut off with "..." instead of
                                 running under the arrow (the ComboBox Padding keeps the
                                 arrow area free). -->
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <!-- A card under the field: the card colours, no shadow. -->
                            <Border Margin="0" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown item: hover the tint; the chosen one a tick in front and
         SemiBold (not a colour fill, so the colour is never the only sign). The
         tick column (20) is always there, so the names line up; not for an item
         with its own checkbox (Tag "check"). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Padding"         Value="6,6,8,6"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="tickBox" Grid.Column="0" Width="20">
                                <Path x:Name="tick" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Margin="2,1,0,0" Data="M0,4 L3.5,7.5 L10,1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- An item with its own checkbox (Tag "check", Options: platforms): no tick column. -->
                        <Trigger Property="Tag" Value="check">
                            <Setter TargetName="tickBox" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Strip (tenant strip, buttons of the source / target card) ───── -->
    <!-- A strip is a row of segments side by side, a 1px line between them
         (StripSep), as the toolbar of the HTML report; the source and target
         card each have one on top (tenant), a StripHSep line between it and
         the policy list; the actions card has the button strip at the
         bottom, under the log. The segments are
         square and fill their cell: the Grid inside the card is clipped to
         the rounded card from code (Initialize-BasetuneWindow), so a coloured
         corner segment (red Cancel) never shows past the corners. Hover:
         the tint only (no line). Dropdowns and text fields never show a
         line: open, keyboard focus and a filter in use show a tint. Buttons:
         an action that can run (Load, Compare, View Report, View Details,
         Download) has a 1px blue line on the bottom edge (StripAccentBtn);
         keyboard focus on any strip button is the tint (StripFocusVisual),
         so the line only means "can be used". Height 34; every
         segment keeps a 2px bottom line (transparent when not in use), so
         its content never moves. -->
    <Style x:Key="StripSep" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Fill"  Value="{DynamicResource CardBorderBrush}"/>
    </Style>
    <!-- Horizontal line between the parts of a card (strip | list | buttons). -->
    <Style x:Key="StripHSep" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill"   Value="{DynamicResource CardBorderBrush}"/>
    </Style>
    <!-- Keyboard focus on a strip button: the hover tint over it, not a line
         (the blue line at the bottom means "can be used", StripAccentBtn). -->
    <Style x:Key="StripFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource HoverBrush}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Neutral segment button (View Report, icon buttons). Disabled: dimmed
         text and icon only (the segment keeps the card colour). Disabled at
         Style level, so the Foreground reaches the icon Paths (they bind to
         the Button's Foreground). -->
    <Style x:Key="StripBtn" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource StripFocusVisual}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource SecBtnFgBrush}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The fill (tint) on the Grid. The BorderThickness keeps its room
                         under the content (transparent), so the content never moves;
                         the line itself (BorderBrush) is a layer of its own, 1px, on the
                         last row of the segment, inside the card's frame: the card edge
                         under it runs on unbroken, as under a filled segment. -->
                    <Grid Background="{TemplateBinding Background}">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Margin="0"
                                Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The first segment of a strip (column 0) sits in the rounded
                             bottom-left corner of its card: the line starts
                             after the rounding (radius 8 - 1 border = 7), so it never runs into the
                             curve and ends cut off. -->
                        <Trigger Property="Grid.Column" Value="0">
                            <Setter TargetName="line" Property="Margin" Value="7,0,0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground"  Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                <Setter Property="Cursor"     Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StripIconBtn" TargetType="Button" BasedOn="{StaticResource StripBtn}">
        <Setter Property="Foreground" Value="{DynamicResource IconFgBrush}"/>
    </Style>
    <!-- An icon segment that asks to be used (Baseline Configuration while no tenant
         is configured, Update-ConfigButtonStyle): the mouse-over look of an icon
         segment kept (the tint and a blue icon), no line, so it also works in the
         rounded corner; mouse-over a stronger tint. The log line names it too
         ("Click the layers icon ..."), so the colour is not the only sign. -->
    <Style x:Key="StripAttentionIconBtn" TargetType="Button" BasedOn="{StaticResource StripIconBtn}">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Action segment (Load; the Download icon with missing definitions): while it can be used
         the Action* colours of the theme (BasetuneWpf.psm1): light a soft blue
         tint with blue text and icon, dark the hover tint with the colour of the
         neutral icon buttons; both a 1px blue line on the bottom edge (ActionLineBrush),
         SemiBold, so it reads as the button to press not by colour alone.
         Mouse-over: ActionHover* (light a stronger tint, dark accent text and
         icon), the line stays. Disabled: as the icon buttons (no fill, no line), dimmed
         text. Busy: the Cancel style (StripCancelBtn, set by
         BasetuneButtons.psm1) replaces it. -->
    <Style x:Key="StripAccentBtn" TargetType="Button" BasedOn="{StaticResource StripBtn}">
        <Setter Property="Background"  Value="{DynamicResource ActionBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ActionLineBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource ActionFgBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource ActionHoverBgBrush}"/>
                <Setter Property="Foreground"  Value="{DynamicResource ActionHoverFgBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="{DynamicResource DisabledFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Cancel (Load, Compare, Export, Download while a job runs, set by
         BasetuneButtons.psm1): as StripAccentBtn in the CancelAction* colours
         (light a soft red tint with red text and a red line, dark the hover tint
         with a red line and, on mouse-over, red text and icon); the X icon and the
         "Cancel" label say what it does, so the red is not the only sign. -->
    <Style x:Key="StripCancelBtn" TargetType="Button" BasedOn="{StaticResource StripAccentBtn}">
        <Setter Property="Background"  Value="{DynamicResource CancelActionBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CancelActionLineBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource CancelActionFgBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource CancelActionHoverBgBrush}"/>
                <Setter Property="Foreground"  Value="{DynamicResource CancelActionHoverFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Action segments (Compare; the layers buttons of the tenant strips, with
         BorderBrush Transparent: no line): as StripAccentBtn. Disabled keeps the
         SemiBold weight: the label keeps its width, so the icon next to it (the
         content is centred) does not move when the button is enabled. -->
    <Style x:Key="StripActiveBtn" TargetType="Button" BasedOn="{StaticResource StripAccentBtn}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="{DynamicResource DisabledFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- The layers button at the bottom left (Baseline Configuration): as
         StripActiveBtn in the Layers* colours, no line. Dark the action tint (as
         Load / Compare), light the look of the icon buttons (no tint, grey icon).
         The two in the tenant strips are StripActiveBtn with BorderBrush
         Transparent: the action colours in both themes, no line. -->
    <Style x:Key="StripLayersBtn" TargetType="Button" BasedOn="{StaticResource StripActiveBtn}">
        <Setter Property="Background"  Value="{DynamicResource LayersBgBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource LayersFgBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LayersHoverBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource LayersHoverFgBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Secondary action segments (View Report, View Details): as StripActiveBtn
         in the SecondaryAction* colours. Light: blue text and icon, no tint and
         no line, so after a compare Compare (tint + line) is the main action;
         dark: as the other action segments. -->
    <Style x:Key="StripSecondaryBtn" TargetType="Button" BasedOn="{StaticResource StripActiveBtn}">
        <Setter Property="Background"  Value="{DynamicResource SecondaryActionBgBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource SecondaryActionFgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryActionLineBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource SecondaryActionHoverBgBrush}"/>
                <Setter Property="Foreground"  Value="{DynamicResource SecondaryActionHoverFgBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="{DynamicResource DisabledFgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>    <!-- Dropdown segment (tenant): no frame of its own; the list opens as
         the normal ComboBox card below the bar. -->
    <ControlTemplate x:Key="StripComboToggleTemplate" TargetType="ToggleButton">
        <!-- The tint on the Grid (also under the line), the line on the Border. -->
        <Grid x:Name="bg" Background="Transparent">
            <Border x:Name="bd" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,14,0"
                      Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <!-- Open: the hover tint (once, not over another) and a blue arrow, no line. -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!-- No line under a dropdown, and only the hover tint, as the text
         segments: no other colour after a click. Keyboard focus (Tab) shows
         the same tint through StripFocusVisual, as on the buttons; WPF shows a
         focus visual for the keyboard only, so a mouse click leaves no tint. -->
    <Style x:Key="StripCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource StripFocusVisual}"/>
        <Setter Property="Height"           Value="34"/>
        <Setter Property="Padding"          Value="14,0,32,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root" Background="Transparent">
                        <ToggleButton x:Name="toggle" Template="{StaticResource StripComboToggleTemplate}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="content" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="1"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <!-- Attached to the strip: right under its bottom line (offset 1),
                                 square top, rounded bottom, the card colours, no shadow. -->
                            <Border Margin="0" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,8,8" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Column header (policy lists: Policy / Platform, click = sort) ── -->
    <!-- 12, capitals; Bold, muted grey. -->
    <Style x:Key="ColumnHeaderBtn" TargetType="Button">
        <Setter Property="Foreground"                 Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="FontSize"                   Value="12"/>
        <Setter Property="FontWeight"                 Value="Bold"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="Focusable"                  Value="False"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment"          Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox ─────────────────────────────────────────────────────── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"               Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Box and tick are separate layers in a 16x16 grid: the tick is
                             drawn in box coordinates (centred), not inside the border.
                             When checked the border is removed (thickness 0) so the box
                             is one solid fill, without the light seam that a 1.5px border
                             on top of the same colour left at some display scalings. -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <!-- Radius 4, not 8 like the rest: 8 on a 16px box makes it a circle (a radio button look). -->
                            <Border x:Name="box" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                            <Path x:Name="tick" Data="M4.2,8.3 L6.9,11 L11.8,5.4" Stroke="{DynamicResource CheckTickBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>                            <!-- Partly selected (IsChecked = null, the select-all box above a
                                 policy list): an accent dot in the empty box, not the usual
                                 dash (that reads as collapse). 8x8 in the 16x16 grid: 4px on
                                 every side, so it sits exactly in the centre. -->
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box"  Property="Background"      Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="box"  Property="BorderThickness" Value="0"/>
                            <Setter TargetName="tick" Property="Visibility"      Value="Visible"/>
                        </Trigger>                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ListBox items (policy lists) ─────────────────────────────────── -->
    <!-- No selection highlight: the checkbox is the state. Hover + keyboard-focus row only.
         Width = the list's visible width (left-aligned): the
         VirtualizingStackPanel can arrange its rows at an older, wider width
         after a fast (diagonal) resize, which pushed Type and Platform out of
         view instead of under their headers. Bound to the ScrollViewer's
         ViewportWidth, every row is exactly as wide as what shows. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Margin"                     Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment"        Value="Left"/>
        <Setter Property="Width"
                Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="6,1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <!-- Row with keyboard focus (arrow keys / Space) -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ToolTip ──────────────────────────────────────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8,4">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scrollbar (thin, rounded) ────────────────────────────────────── -->
    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels"   Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width"    Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Width="8" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="8" Margin="2,3" Background="{DynamicResource ScrollThumbBrush}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <!-- Nothing to scroll (bar forced visible, e.g. the policy lists):
                                 keep the space, hide the thumb. -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="Maximum" Value="0">
                                    <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Height="8" Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="8" Margin="3,2" Background="{DynamicResource ScrollThumbBrush}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Busy bar on the bottom edge of the actions card (indeterminate only).
         A short accent segment with soft ends glides over the edge with an
         ease-in-out. The segment is an OpacityMask whose RelativeTransform
         is animated in fractions of the bar width, so it adapts to any
         window width without code. -->
    <Style x:Key="BusyBar" TargetType="ProgressBar">
        <Setter Property="Height"          Value="1"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <!-- Both ends of the bar fade out, so the segment fades in
                             at the start and out at the end instead of being cut
                             off straight at the edges. -->
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black"       Offset="0.12"/>
                                <GradientStop Color="Black"       Offset="0.88"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <Rectangle x:Name="Segment" Fill="{TemplateBinding Foreground}"
                                   RadiusX="0.5" RadiusY="0.5" Opacity="0">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.3"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="Black"       Offset="0.09"/>
                                    <GradientStop Color="Black"       Offset="0.21"/>
                                    <GradientStop Color="Transparent" Offset="0.30"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Segment" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BusySlide">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Segment"
                                                         Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.3" To="1.0" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BusySlide"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer: scrollbars only when needed -->
    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

</ResourceDictionary>
