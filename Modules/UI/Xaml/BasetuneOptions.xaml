<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <!-- Styles and colours come from BasetuneTheme.xaml (application
         resources, loaded by Load-Xaml). Light/dark switches live. -->

    <!-- Own title bar + frame (WindowChrome), same as the main window: no
         invisible Windows border, so a Dell Display Manager zone next to a
         monitor with another scaling no longer makes the window bigger.
         The size stays fixed: a zone only sets the position (see
         Initialize-DialogChrome in BasetuneWpf.psm1). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="imgDlgIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,8,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SubTextBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button x:Name="btnDlgClose" Grid.Column="2" Style="{StaticResource CaptionCloseBtn}"
                    Content="&#xE8BB;" ToolTip="Close"/>
        </Grid>

    <!-- Outer spacing as in the main window: 20 left/right, 16 under the
         title bar and at the bottom. Card padding 15 at the top, so the first
         field lines up with the tenant dropdown in the main window (main card:
         padding 10 + label 16 + 10 = 36; here 15 + label 17 + 4 = 36). 18 at
         the bottom, 12 between the field rows. The Tenant Configuration window
         is then not higher than the main window at its minimum height (400). -->
    <Grid Margin="20,16,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0" Padding="20,15,20,18">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FL}" Text="Report Folder"/>
                        <Grid>
                            <TextBox x:Name="cfgPathReport" Padding="8,4,32,4"/>
                            <Button x:Name="btnBrowsePathReport"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="28" Height="24" Margin="0,0,4,0"
                                    Style="{StaticResource InlineBtn}"
                                    FontSize="12" Content="...">
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
                <!-- Platforms over the full width. -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FL}" Text="Platforms"/>
                    <!-- Multi-select: the items are checkboxes (filled by Open-OptionsWindow);
                         the text on top shows the selection ("Windows, macOS"). -->
                    <Grid>
                        <ComboBox x:Name="cmbPlatforms"
                                  ToolTip="Settings Catalog platforms to load"/>
                        <TextBlock x:Name="txtPlatforms" IsHitTestVisible="False" FontSize="13"
                                   Margin="11,0,30,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                </StackPanel>
                <!-- Theme and Max Threads side by side, both dropdowns equally wide. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FL}" Text="Theme"/>
                        <!-- Filled with Dark / Light by Open-OptionsWindow; applied on Save Settings. -->
                        <ComboBox x:Name="cmbTheme"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FL}" Text="Max Threads"/>
                        <!-- Filled with 1..32 by Open-OptionsWindow; only valid values can be picked. -->
                        <ComboBox x:Name="cmbMaxThreads"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSaveSettings" Style="{StaticResource PrimaryBtn}"
                    Content="Save Settings" MinWidth="110" Height="32" Padding="12,0" Margin="0,0,12,0"
                    IsEnabled="False"/>
            <Button x:Name="btnCloseSettings" Style="{StaticResource SecBtn}"
                    Content="Close" MinWidth="80" Height="32" Padding="12,0"/>
        </StackPanel>
    </Grid>
    </DockPanel>
    </Border>
</Window>
